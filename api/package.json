{
  "name": "family-dashboard-api",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Functions backend for the family dashboard",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && func start",
    "seed": "tsx scripts/seed.mts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/functions": "^4.6.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/storage-blob": "~12.32.0",
    "@types/luxon": "^3.7.3",
    "@types/node": "^26.1.2",
    "azurite": "^3.36.0",
    "esbuild": "^0.28.1",
    "luxon": "^3.7.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
